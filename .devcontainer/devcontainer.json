{
    "name": "ROS Development Container",
    "privileged": true,
    "remoteUser": "vscode",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2.12.4": {
            "version": "latest",
            "moby": true
        },
        "ghcr.io/devcontainers-extra/features/cmake:1": {
            "version": "3.31.9"
        }
    },
    "customizations": {
        "vscode": {
            "extensions":[
                // Repo
                "ms-azuretools.vscode-docker",
                "github.vscode-github-actions",
                
                // C++ Extensions
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",

                // Python Stack
                "ms-python.python",

                // ROS Extensions
                "ms-iot.vscode-ros",

                // Documentation
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one",
                "redhat.vscode-yaml",
                "shardulm94.trailing-spaces",
            ]
        }
    },
    "containerEnv": {
        "ROS_DOMAIN_ID": "42",
        "GZ_VERSION": "jetty",
        "ROS_VERSION": "kilted"
    },
    "runArgs": [
        "--net=host",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "mounts": [
        "source=${localWorkspaceFolder}/.cache,target=/home/rosuser/.cache,type=bind"
    ],
    "onCreateCommand": ".devcontainer/init.sh"
}
